# Copy to .env and fill in. Every key is optional: without keys the app runs in
# labeled sample mode (scripted coach, typed role-play).

# --- ElevenLabs: voice role-play, coach agent, mic speech-to-text, and voice-over ---
# API key: https://elevenlabs.io/app/settings/api-keys
# Secret: used only by the server (xi-api-key header); the browser receives single-use tokens.
# Recommended restrictions: scope to ElevenLabs Agents, Speech to Text, and Text to Speech, set a credit quota, and if you
# IP-allowlist the key, include the server's public IP. Verify with `npm run elevenlabs:check`.
ELEVENLABS_API_KEY=
# Create both agents with `npm run elevenlabs:setup` (or `docker compose run --rm elevenlabs-setup`)
# Voice agent that plays the fictional professional (role-play)
ELEVENLABS_AGENT_ID=
# Text-only agent that powers the Sariel coach (onboarding, lesson Q&A, feedback, reflection)
ELEVENLABS_COACH_AGENT_ID=
# webrtc (recommended) or websocket
ELEVENLABS_CONNECTION_TYPE=webrtc

# --- AI coach backend ---
# auto (default) uses the ElevenLabs coach agent when set, otherwise the OpenAI-compatible key below.
COACH_PROVIDER=auto

# Optional alternative coach: any OpenAI-compatible Chat Completions API.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Host port for docker compose
APP_PORT=3000
