# Copy to .env and fill in. Every key is optional: without keys the app runs in
# labeled sample mode (scripted coach, typed role-play).

# --- ElevenLabs: voice role-play (step 4) ---
# API key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Create the agent with `npm run elevenlabs:setup` (or `docker compose run --rm elevenlabs-setup`)
ELEVENLABS_AGENT_ID=
# webrtc (recommended) or websocket
ELEVENLABS_CONNECTION_TYPE=webrtc

# --- AI coach: onboarding, lesson Q&A, question + conversation feedback ---
# Any OpenAI-compatible Chat Completions API (OpenAI, OpenRouter, Groq, Together, local Ollama...).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Host port for docker compose
APP_PORT=3000
